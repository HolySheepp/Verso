{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verso",
  "version": "0.57.0",
  "identifier": "app.verso.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../建置暫存/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Verso",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "TradChinese"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./installer-hooks.nsh",
        "template": "./installer-template.nsi"
      }
    },
    "publisher": "Verso",
    "shortDescription": "Verso 翻譯工作台"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzRUE2Q0U0Q0U4QzEyNDEKUldSQkVvek81R3pxazNMNWFYZEhZR0NnVmt2VkM1TndsK1NvZ0pWWkRUa0tPNnNnczJrSklrNlYK",
      "endpoints": [
        "https://github.com/HolySheepp/Verso/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
